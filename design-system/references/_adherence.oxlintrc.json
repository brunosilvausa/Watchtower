{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "playground/**",
              "ui_kits/app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmbientBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:parallax|intensity|position|style|key|ref|className|style|children)$/]",
        "message": "<AmbientBackdrop> doesn't accept that prop. Declared props: parallax, intensity, position, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmbientBackdrop'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute)$/]",
        "message": "<AmbientBackdrop> position must be one of 'fixed' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:searchPlaceholder|onSearch|actions|user|breadcrumbs|title|onCommand|shortcut|onMenu|style|key|ref|className|style|children)$/]",
        "message": "<AppTopBar> doesn't accept that prop. Declared props: searchPlaceholder, onSearch, actions, user, breadcrumbs, title, onCommand, shortcut, onMenu, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|uppercase|shape|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, uppercase, shape, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|yellow|up|down|degraded|info|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'yellow' | 'up' | 'down' | 'degraded' | 'info' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|labels|comparison|name|comparisonName|height|min|max|ticks|format|formatAxis|color|highlight|onHighlight|loading|error|emptyText|ariaLabel|animate|style|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, labels, comparison, name, comparisonName, height, min, max, ticks, format, formatAxis, color, highlight, onHighlight, loading, error, emptyText, ariaLabel, animate, style."
