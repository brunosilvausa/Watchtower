# Public LOCAL development credentials only. Never use these on a deployed host.
DATABASE_URL=postgresql://watchtower_app:local-app-only@127.0.0.1:55432/watchtower_dev
DATABASE_MIGRATION_URL=postgresql://watchtower_migrator:local-migrator-only@127.0.0.1:55432/watchtower_dev
DATABASE_TEST_URL=postgresql://watchtower_app:local-app-only@127.0.0.1:55432/watchtower_dev
LOG_LEVEL=info

# Run pnpm setup:product to generate local secrets without printing them.
DATABASE_WORKER_URL=postgresql://watchtower_worker:local-worker-only@127.0.0.1:55432/watchtower_dev
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
PRODUCT_ENCRYPTION_KEY=
MAIL_TRANSPORT=local
AUTH_MAIL_DIRECTORY=
WATCHTOWER_REGION=local
# Worker stays inactive unless explicitly enabled by dev:monitoring or this setting.
WATCHTOWER_WORKER_ENABLED=false
# Provider credentials are optional; unconfigured operations return explicit errors.
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Private agent: HTTPS control URL, one-time enrollment token, explicit allowed CIDRs.
WATCHTOWER_CONTROL_URL=
WATCHTOWER_PROBE_TOKEN=
WATCHTOWER_PRIVATE_CIDRS=
