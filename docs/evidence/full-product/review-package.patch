e="submit" loading={busy}>Inscrever / Subscribe</Button></form></Card><div className={styles.row}><Button variant="secondary" disabled={busy} onClick={() => { const token = new URLSearchParams(window.location.search).get("verify"); if (token) void subscription("verify", { token }); else setError("Abra o link recebido por e-mail / Open the emailed link"); }}>Confirmar inscrição / Confirm subscription</Button><Button variant="ghost" disabled={busy} onClick={() => { const token = new URLSearchParams(window.location.search).get("unsubscribe"); if (token) void subscription("unsubscribe", { token }); else setError("Abra o link de cancelamento do e-mail / Open the emailed unsubscribe link"); }}>Cancelar inscrição / Unsubscribe</Button></div><p className={styles.muted}>Estados baseados em observações. Sem observações significa desconhecido.<br />States reflect observations. Missing observations mean unknown.</p></>}</main>;
