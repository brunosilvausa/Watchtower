+CREATE FUNCTION accept_invitation(invite_hash text, actor text) RETURNS uuid LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE invitation invitations; user_email text; selected_workspace uuid; BEGIN
+SELECT email INTO user_email FROM auth_user WHERE id=actor AND "emailVerified";
+IF user_email IS NULL THEN RAISE EXCEPTION 'Verified identity required' USING ERRCODE='42501'; END IF;
+-- Global hash lookup is private; only this narrowly checked function may use it.
+SELECT workspace_id INTO selected_workspace FROM invitation_lookup WHERE token_hash=invite_hash;
+IF selected_workspace IS NULL THEN RAISE EXCEPTION 'Invitation unavailable' USING ERRCODE='42501'; END IF;
+PERFORM set_config('app.workspace_id',selected_workspace::text,true);
+PERFORM 1 FROM workspaces WHERE id=selected_workspace AND NOT suspended FOR UPDATE;
+IF NOT FOUND THEN RAISE EXCEPTION 'Workspace unavailable' USING ERRCODE='42501'; END IF;
+SELECT * INTO invitation FROM invitations WHERE token_hash=invite_hash FOR UPDATE;
+IF invitation.accepted_at IS NOT NULL OR invitation.cancelled_at IS NOT NULL OR invitation.expires_at<=now() OR lower(invitation.email)<>lower(user_email) THEN RAISE EXCEPTION 'Invitation unavailable' USING ERRCODE='42501'; END IF;
+INSERT INTO users(id) VALUES(actor) ON CONFLICT DO NOTHING;
+INSERT INTO memberships(workspace_id,user_id,role) VALUES(selected_workspace,actor,invitation.role) ON CONFLICT DO NOTHING;
+UPDATE invitations SET accepted_at=now() WHERE id=invitation.id;
