+CREATE TABLE product_public_index(kind text NOT NULL,lookup text NOT NULL,workspace_id uuid NOT NULL,resource_id uuid NOT NULL,PRIMARY KEY(kind,lookup));
+CREATE FUNCTION sync_public_index() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE kind text; lookup text; BEGIN kind:=TG_TABLE_NAME; IF TG_OP='DELETE' THEN DELETE FROM product_public_index WHERE product_public_index.kind=kind AND resource_id=OLD.id; RETURN OLD; END IF; IF kind='api_keys' THEN lookup:=NEW.token_hash; ELSIF kind='monitors' THEN lookup:=NEW.heartbeat_hash; ELSE lookup:=NEW.slug; END IF; DELETE FROM product_public_index WHERE product_public_index.kind=kind AND resource_id=NEW.id; IF lookup IS NOT NULL THEN INSERT INTO product_public_index VALUES(kind,lookup,NEW.workspace_id,NEW.id); END IF; RETURN NEW; END $$;
+CREATE TRIGGER api_lookup AFTER INSERT OR UPDATE OR DELETE ON api_keys FOR EACH ROW EXECUTE FUNCTION sync_public_index();
+CREATE TRIGGER status_lookup AFTER INSERT OR UPDATE OR DELETE ON status_pages FOR EACH ROW EXECUTE FUNCTION sync_public_index();
+CREATE TRIGGER heartbeat_lookup AFTER INSERT OR UPDATE OR DELETE ON monitors FOR EACH ROW EXECUTE FUNCTION sync_public_index();
+CREATE FUNCTION resolve_product_key(hash text) RETURNS TABLE(workspace_id uuid,user_id text,scopes text[]) LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE item record; BEGIN SELECT * INTO item FROM product_public_index WHERE kind='api_keys' AND lookup=hash; IF NOT FOUND THEN RETURN; END IF; PERFORM set_config('app.workspace_id',item.workspace_id::text,true); RETURN QUERY SELECT k.workspace_id,k.created_by,k.scopes FROM api_keys k JOIN workspaces w ON w.id=k.workspace_id WHERE k.id=item.resource_id AND k.revoked_at IS NULL AND (k.expires_at IS NULL OR k.expires_at>now()) AND NOT w.suspended; END $$;
+CREATE FUNCTION read_status_page(page_slug text) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE item record; page record; result jsonb; BEGIN SELECT * INTO item FROM product_public_index WHERE kind='status_pages' AND lookup=page_slug; IF NOT FOUND THEN RETURN NULL; END IF; PERFORM set_config('app.workspace_id',item.workspace_id::text,true); SELECT p.* INTO page FROM status_pages p JOIN workspaces w ON w.id=p.workspace_id WHERE p.id=item.resource_id AND p.published AND NOT w.suspended; IF NOT FOUND THEN RETURN NULL; END IF; SELECT jsonb_build_object('id',page.id,'name',page.name,'slug',page.slug,'config',page.config,'passwordHash',page.password_hash,'components',coalesce((SELECT jsonb_agg(jsonb_build_object('id',m.id,'name',m.name,'state',CASE WHEN m.paused THEN 'paused' ELSE m.state END)) FROM status_components c JOIN monitors m ON m.id=c.monitor_id AND m.workspace_id=c.workspace_id WHERE c.page_id=page.id),'[]'::jsonb),'updates',coalesce((SELECT jsonb_agg(jsonb_build_object('title',u.title,'body',u.body,'created_at',u.created_at)) FROM (SELECT * FROM status_updates WHERE page_id=page.id ORDER BY created_at DESC LIMIT 30)u),'[]'::jsonb)) INTO result; RETURN result; END $$;
+CREATE FUNCTION receive_heartbeat(hash text) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE item record; BEGIN SELECT * INTO item FROM product_public_index WHERE kind='monitors' AND lookup=hash; IF NOT FOUND THEN RETURN false; END IF; PERFORM set_config('app.workspace_id',item.workspace_id::text,true); UPDATE monitors SET heartbeat_seen_at=now() WHERE id=item.resource_id AND NOT paused AND archived_at IS NULL AND EXISTS(SELECT 1 FROM workspaces WHERE id=item.workspace_id AND NOT suspended); RETURN FOUND; END $$;
+CREATE FUNCTION platform_snapshot(actor text) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE item record; tenants jsonb:='[]'; BEGIN IF NOT EXISTS(SELECT 1 FROM auth_user WHERE id=actor AND "platformAdmin") THEN RAISE EXCEPTION 'Platform access denied' USING ERRCODE='42501'; END IF; FOR item IN SELECT DISTINCT workspace_id FROM workspace_access LOOP PERFORM set_config('app.workspace_id',item.workspace_id::text,true); SELECT tenants||jsonb_build_array(jsonb_build_object('id',w.id,'name',w.name,'plan',w.plan,'suspended',w.suspended,'created_at',w.created_at,'monitors',(SELECT count(*) FROM monitors WHERE workspace_id=w.id AND archived_at IS NULL),'members',(SELECT count(*) FROM memberships WHERE workspace_id=w.id))) INTO tenants FROM workspaces w WHERE id=item.workspace_id; END LOOP; RETURN jsonb_build_object('tenants',tenants,'probes',coalesce((SELECT jsonb_agg(to_jsonb(p)-'enrollment_hash') FROM probes p),'[]'::jsonb),'flags',coalesce((SELECT jsonb_agg(to_jsonb(f)) FROM feature_flags f),'[]'::jsonb)); END $$;
+CREATE FUNCTION platform_mutation(actor text,action text,identifier text,payload jsonb) RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ BEGIN IF NOT EXISTS(SELECT 1 FROM auth_user WHERE id=actor AND "platformAdmin") THEN RAISE EXCEPTION 'Platform access denied' USING ERRCODE='42501'; END IF; IF action IN ('suspend','restore') THEN PERFORM set_config('app.workspace_id',identifier,true); UPDATE workspaces SET suspended=(action='suspend') WHERE id=identifier::uuid; IF NOT FOUND THEN RAISE EXCEPTION 'Workspace unavailable'; END IF; IF action='suspend' THEN UPDATE monitors SET lease_token=NULL,lease_until=NULL WHERE workspace_id=identifier::uuid; END IF; INSERT INTO audit_events(workspace_id,actor_id,action,resource_type,resource_id) VALUES(identifier::uuid,actor,action,'workspace',identifier); ELSIF action='drain' THEN UPDATE probes SET draining=coalesce((payload->>'draining')::boolean,true) WHERE id=identifier; ELSIF action='flag' THEN INSERT INTO feature_flags(key,enabled,rollout) VALUES(identifier,(payload->>'enabled')::boolean,(payload->>'rollout')::int) ON CONFLICT(key) DO UPDATE SET enabled=EXCLUDED.enabled,rollout=EXCLUDED.rollout; ELSE RAISE EXCEPTION 'Unsupported platform action'; END IF; END $$;
+CREATE FUNCTION apply_billing_event(event_id text,event_hash text,workspace uuid,customer text,subscription text,plan_name text,subscription_state text,period_end timestamptz) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ BEGIN INSERT INTO billing_events(id,payload_hash) VALUES(event_id,event_hash) ON CONFLICT DO NOTHING; IF NOT FOUND THEN RETURN false; END IF; PERFORM set_config('app.workspace_id',workspace::text,true); IF NOT EXISTS(SELECT 1 FROM workspaces WHERE id=workspace) THEN RAISE EXCEPTION 'Unknown workspace'; END IF; INSERT INTO subscriptions(workspace_id,provider_customer_id,provider_subscription_id,plan,state,current_period_end) VALUES(workspace,customer,subscription,plan_name,subscription_state,period_end) ON CONFLICT(workspace_id) DO UPDATE SET provider_customer_id=EXCLUDED.provider_customer_id,provider_subscription_id=EXCLUDED.provider_subscription_id,plan=EXCLUDED.plan,state=EXCLUDED.state,current_period_end=EXCLUDED.current_period_end,updated_at=now(); UPDATE workspaces SET plan=CASE WHEN subscription_state IN ('active','trialing') THEN plan_name ELSE 'free' END WHERE id=workspace; RETURN true; END $$;
+REVOKE ALL ON ALL FUNCTIONS IN SCHEMA public FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION resolve_product_key(text),read_status_page(text),receive_heartbeat(text),platform_snapshot(text),platform_mutation(text,text,text,jsonb),apply_billing_event(text,text,uuid,text,text,text,text,timestamptz) TO watchtower_app;
