+CREATE TABLE invitation_lookup (token_hash text PRIMARY KEY, workspace_id uuid NOT NULL);
+CREATE FUNCTION sync_invitation_lookup() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ BEGIN IF TG_OP='DELETE' THEN DELETE FROM invitation_lookup WHERE token_hash=OLD.token_hash; RETURN OLD; END IF; IF TG_OP='UPDATE' THEN DELETE FROM invitation_lookup WHERE token_hash=OLD.token_hash; END IF; INSERT INTO invitation_lookup VALUES(NEW.token_hash,NEW.workspace_id) ON CONFLICT DO NOTHING; RETURN NEW; END $$;
+CREATE TRIGGER invitation_lookup_sync AFTER INSERT OR UPDATE OR DELETE ON invitations FOR EACH ROW EXECUTE FUNCTION sync_invitation_lookup();
+REVOKE ALL ON FUNCTION accept_invitation(text,text),sync_invitation_lookup() FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION accept_invitation(text,text) TO watchtower_app;
