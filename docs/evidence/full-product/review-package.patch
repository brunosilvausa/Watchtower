+CREATE FUNCTION apply_billing_snapshot(event_id text,event_hash text,workspace uuid,customer text,subscription text,plan_name text,subscription_state text,period_end timestamptz,event_created bigint,amount numeric,currency_code text) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE previous record; BEGIN
+IF plan_name NOT IN ('free','solo','team','enterprise') OR subscription_state NOT IN ('active','trialing','past_due','unpaid','canceled','cancelled','incomplete','incomplete_expired','paused') OR amount<0 THEN RAISE EXCEPTION 'Invalid billing snapshot'; END IF;
+PERFORM set_config('app.workspace_id',workspace::text,true); PERFORM 1 FROM workspaces WHERE id=workspace FOR UPDATE; IF NOT FOUND THEN RAISE EXCEPTION 'Unknown workspace'; END IF;
+SELECT * INTO previous FROM billing_events WHERE id=event_id; IF FOUND THEN IF previous.payload_hash<>event_hash THEN RAISE EXCEPTION 'Billing event changed'; END IF; RETURN false; END IF;
+INSERT INTO billing_events(id,payload_hash) VALUES(event_id,event_hash);
+SELECT * INTO previous FROM subscriptions WHERE workspace_id=workspace;
+IF FOUND AND previous.provider_event_created>event_created THEN RETURN false; END IF;
+IF FOUND AND previous.provider_subscription_id IS NOT NULL AND previous.provider_subscription_id<>subscription AND previous.state IN ('active','trialing') THEN RAISE EXCEPTION 'Subscription conflict'; END IF;
+INSERT INTO subscriptions(workspace_id,provider_customer_id,provider_subscription_id,plan,state,current_period_end,provider_event_created,monthly_amount,currency) VALUES(workspace,customer,subscription,plan_name,subscription_state,period_end,event_created,amount,currency_code) ON CONFLICT(workspace_id) DO UPDATE SET provider_customer_id=EXCLUDED.provider_customer_id,provider_subscription_id=EXCLUDED.provider_subscription_id,plan=EXCLUDED.plan,state=EXCLUDED.state,current_period_end=EXCLUDED.current_period_end,provider_event_created=EXCLUDED.provider_event_created,monthly_amount=EXCLUDED.monthly_amount,currency=EXCLUDED.currency,updated_at=now();
+UPDATE workspaces SET plan=CASE WHEN subscription_state IN ('active','trialing') THEN plan_name ELSE 'free' END WHERE id=workspace; RETURN true; END $$;
