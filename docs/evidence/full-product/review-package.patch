+CREATE FUNCTION workspace_capabilities(actor text,tenant uuid) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE access record; BEGIN SELECT * INTO access FROM authorize_workspace(actor,tenant); IF (access IS NULL AND NOT EXISTS(SELECT 1 FROM support_sessions s JOIN auth_user u ON u.id=s.actor_id WHERE s.actor_id=actor AND s.workspace_id=tenant AND s.expires_at>now() AND u."platformAdmin")) OR access.suspended THEN RAISE EXCEPTION 'Workspace denied' USING ERRCODE='42501'; END IF; RETURN jsonb_build_object('regions',coalesce((SELECT jsonb_agg(jsonb_build_object('id',p.id,'region',p.region,'capabilities',p.capabilities,'lastSeenAt',p.last_seen_at,'private',p.workspace_id IS NOT NULL)) FROM probes p WHERE (p.workspace_id IS NULL OR p.workspace_id=tenant) AND NOT p.draining AND p.last_seen_at>now()-interval '2 minutes'),'[]'::jsonb)); END $$;
