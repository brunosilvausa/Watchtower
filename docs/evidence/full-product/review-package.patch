+CREATE OR REPLACE FUNCTION platform_snapshot(actor text) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=public,pg_temp AS $$ DECLARE item record; tenants jsonb:='[]'; BEGIN IF NOT EXISTS(SELECT 1 FROM auth_user WHERE id=actor AND "platformAdmin") THEN RAISE EXCEPTION 'Platform access denied' USING ERRCODE='42501'; END IF; FOR item IN SELECT DISTINCT workspace_id FROM workspace_access LOOP PERFORM set_config('app.workspace_id',item.workspace_id::text,true); SELECT tenants||jsonb_build_array(jsonb_build_object('id',w.id,'name',w.name,'plan',w.plan,'suspended',w.suspended,'created_at',w.created_at,'monitors',(SELECT count(*) FROM monitors WHERE workspace_id=w.id AND archived_at IS NULL),'members',(SELECT count(*) FROM memberships WHERE workspace_id=w.id),'subscription',(SELECT jsonb_build_object('state',s.state,'monthlyAmount',s.monthly_amount,'currency',s.currency) FROM subscriptions s WHERE s.workspace_id=w.id))) INTO tenants FROM workspaces w WHERE id=item.workspace_id; END LOOP; RETURN jsonb_build_object('tenants',tenants,'probes',coalesce((SELECT jsonb_agg(to_jsonb(p)-'enrollment_hash') FROM probes p),'[]'::jsonb),'flags',coalesce((SELECT jsonb_agg(to_jsonb(f)) FROM feature_flags f),'[]'::jsonb)); END $$;
